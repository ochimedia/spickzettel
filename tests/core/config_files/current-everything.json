{
  "version": 2,
  "hotkeys": {
    "editMode": "Ctrl+Shift+D",
    "viewMode": "F9",
    "quickCapture": "Ctrl+Alt+Shift+S",
    "silentCapture": null
  },
  "drawing": {
    "strokeColor": "#00FF00",
    "strokeWidth": 6.5,
    "raiseSelected": false,
    "screenshotTrigger": "alt",
    "drawingTrigger": "off"
  },
  "appearance": {
    "showItemBorders": false,
    "showToastsWhileHidden": false,
    "imageFilter": "lanczos",
    "accentColor": "#8040C0",
    "uiScale": 150,
    "snippetColors": {
      "borderFront": "#11223344",
      "borderOther": "#55667788",
      "borderPinned": "#99AABBCC",
      "borderSelectedFollowsAccent": false,
      "borderSelected": "#DDEEFF80"
    },
    "canvasBar": {
      "show": false
    },
    "editModeBorder": {
      "show": false,
      "color": "#5AA9FF66",
      "width": 16.0,
      "onlyWhenEmpty": true
    }
  },
  "bars": {
    "snippet": [
      {
        "button": "more",
        "shown": true
      },
      {
        "button": "pin",
        "shown": true
      },
      {
        "button": "minimize",
        "shown": false
      },
      {
        "button": "maximize",
        "shown": true
      },
      {
        "button": "close",
        "shown": true
      }
    ],
    "drawing": [
      {
        "button": "pen",
        "shown": true
      },
      {
        "button": "eraser",
        "shown": true
      },
      {
        "button": "text",
        "shown": true
      },
      {
        "button": "color",
        "shown": false
      }
    ]
  },
  "overview": {
    "showStrokes": false,
    "showBitmaps": false
  },
  "defaults": {
    "screenshot": {
      "keepAspect": false,
      "foregroundOpacity": 0.5,
      "backgroundOpacity": 0.75
    },
    "drawing": {
      "keepAspect": false,
      "foregroundOpacity": 0.8,
      "backgroundOpacity": 0.25,
      "backgroundColor": "#FFF0C0"
    },
    "text": {
      "color": "#000000C0",
      "size": 28.0
    }
  },
  "deleted": {
    "confirmDelete": false,
    "confirmDeleteForGood": false,
    "deleteForGoodAutomatically": false,
    "afterDays": 21
  },
  "display": {
    "id": "\\\\?\\DISPLAY#TEST#1",
    "name": "Test Display"
  },
  "behavior": {
    "dontStealFocus": false,
    "takeFocusOverElevated": false,
    "softwarePointer": false,
    "rawMouseInput": false,
    "dontForwardKeystrokes": false,
    "counterRawMouseInput": true,
    "counterThreshold": 40,
    "freezeScreen": true
  },
  "shortcuts": {
    "pen": "Shift+Q",
    "eraser": null,
    "text": "Ctrl+Mouse3",
    "select": null,
    "newScreenshot": "S",
    "newDrawing": "D",
    "newCanvas": null,
    "newCanvasWithSelection": "Ctrl+Shift+N",
    "selectAll": "Ctrl+A",
    "copy": "Ctrl+C",
    "cut": "Ctrl+X",
    "paste": "Ctrl+V",
    "pasteInPlace": "Ctrl+Shift+V",
    "duplicate": "Ctrl+D",
    "cheatSheet": "F1"
  },
  "tutorial": {
    "progress": {
      "basics": "finished",
      "drawing": "started"
    }
  },
  "diagnostics": {
    "showDebugOverlay": true,
    "showInputOptionsHud": true,
    "showFrameGraph": true
  },
  "profiles": [
    {
      "name": "Game",
      "match": {
        "exe": [
          "game.exe",
          "launcher.exe"
        ],
        "titleContains": [
          "Game Window"
        ]
      },
      "behavior": {
        "dontStealFocus": false,
        "takeFocusOverElevated": false,
        "softwarePointer": false,
        "rawMouseInput": false,
        "dontForwardKeystrokes": false,
        "counterRawMouseInput": true,
        "counterThreshold": 250,
        "freezeScreen": true
      },
      "shortcuts": {
        "pen": "W",
        "eraser": null
      }
    },
    {
      "name": "Notes",
      "match": {
        "exe": [],
        "titleContains": [
          "Notepad"
        ]
      }
    }
  ]
}
