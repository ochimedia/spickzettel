{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-msvc-debug",
      "displayName": "Windows (MSVC + Ninja, Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SPICKZETTEL_BUILD_TESTS": "ON",
        "SPICKZETTEL_UI_TESTS": "ON"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "windows-msvc-asan",
      "displayName": "Windows (MSVC + Ninja, Debug, AddressSanitizer)",
      "inherits": "windows-msvc-debug",
      "binaryDir": "${sourceDir}/build/windows-asan",
      "cacheVariables": {
        "SPICKZETTEL_ASAN": "ON"
      }
    },
    {
      "name": "windows-msvc-release",
      "displayName": "Windows (MSVC + Ninja, Release)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SPICKZETTEL_BUILD_TESTS": "ON",
        "SPICKZETTEL_EXE_NAME": "Spickzettel",
        "SPICKZETTEL_COPY_TO_DIST": "ON"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "windows-msvc-demo",
      "displayName": "Windows (MSVC + Ninja, Release, demo watermark)",
      "inherits": "windows-msvc-release",
      "binaryDir": "${sourceDir}/build/windows-demo",
      "cacheVariables": {
        "SPICKZETTEL_DEMO_MODE": "ON",
        "SPICKZETTEL_EXE_NAME": "Spickzettel Demo",
        "SPICKZETTEL_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "windows-msvc-prerelease",
      "displayName": "Windows (MSVC + Ninja, Release, prerelease notice)",
      "inherits": "windows-msvc-release",
      "binaryDir": "${sourceDir}/build/windows-prerelease",
      "cacheVariables": {
        "SPICKZETTEL_PRERELEASE_NOTICE": "ON",
        "SPICKZETTEL_EXE_NAME": "Spickzettel Prerelease",
        "SPICKZETTEL_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "linux-tests",
      "displayName": "Linux (portable core and its tests only)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-tests",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SPICKZETTEL_BUILD_TESTS": "ON"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    }
  ],
  "buildPresets": [
    { "name": "windows-msvc-debug", "configurePreset": "windows-msvc-debug" },
    { "name": "windows-msvc-asan", "configurePreset": "windows-msvc-asan" },
    { "name": "windows-msvc-release", "configurePreset": "windows-msvc-release" },
    { "name": "windows-msvc-demo", "configurePreset": "windows-msvc-demo" },
    { "name": "windows-msvc-prerelease", "configurePreset": "windows-msvc-prerelease" },
    { "name": "linux-tests", "configurePreset": "linux-tests" }
  ],
  "testPresets": [
    { "name": "windows-msvc-debug", "configurePreset": "windows-msvc-debug", "output": { "outputOnFailure": true } },
    { "name": "windows-msvc-asan", "configurePreset": "windows-msvc-asan", "output": { "outputOnFailure": true } },
    { "name": "windows-msvc-release", "configurePreset": "windows-msvc-release", "output": { "outputOnFailure": true } },
    { "name": "linux-tests", "configurePreset": "linux-tests", "output": { "outputOnFailure": true } }
  ]
}
